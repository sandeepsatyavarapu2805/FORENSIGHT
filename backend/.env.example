DB_USER=forensight_app
DB_PASSWORD=replace-with-a-local-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forensight
# Render may supply DATABASE_URL instead of the DB_* values above.
# DATABASE_URL=postgresql://user:password@host:5432/database
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=12
UPLOAD_STORAGE_PATH=var/uploads
UPLOAD_MAX_BYTES=536870912
ARCHIVE_MAX_MEMBERS=100000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648
ARCHIVE_MAX_COMPRESSION_RATIO=1000
ARCHIVE_MAX_REPORT_XML_BYTES=268435456
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=20
AI_CONTEXT_MAX_ITEMS=12
AI_CONTEXT_EXCERPT_CHARS=1000
AI_CONTEXT_DATA_CHARS=1500
